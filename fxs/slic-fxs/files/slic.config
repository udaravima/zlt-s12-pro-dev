config slic 'main'
	# 0 disables the phone port entirely (modules not loaded)
	option enabled '1'
	# slic_clk_switch (GPIO 32): 0 = router PCM (needed for audio playback),
	# 1 = modem PCM (stock VoLTE wiring; ring/tone still work)
	option clk_switch '0'
	# SPI clock for the SLIC in Hz (stock firmware used up to 2048000)
	option spi_hz '1000000'
	# caller ID format for 'ring SECS NUMBER [NAME]': bell (FSK after 1st ring),
	# v23 (ETSI FSK before 1st ring), dtmf (DTMF before 1st ring)
	option cid_format 'bell'
	# where the daemon accepts Asterisk's AudioSocket connections (calls to
	# and from the handset); keep it on loopback. "off" disables calls.
	option audiosocket '127.0.0.1:4573'
	# seconds of keypad silence that end dialling ('#' dials at once)
	option dial_timeout '3'
