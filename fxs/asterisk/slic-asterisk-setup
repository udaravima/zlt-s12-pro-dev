#!/bin/sh
# slic-asterisk-setup - turn the router into a LAN-only home PBX with the
# RJ11 phone as extension 100. Safe to re-run.
#
#   slic-asterisk-setup              install modules, configs, secrets; start
#   slic-asterisk-setup --no-apk     skip `apk add` (modules already there)
#   slic-asterisk-setup --new-passwords   regenerate SIP passwords
#   APP=192.168.1.20:9092 slic-asterisk-setup   AudioSocket app for ext 800
#
# What it does, in order:
#   1. apk add the Asterisk modules this setup uses (official telephony feed)
#   2. finds the LAN address from the firewall's "lan" zone
#   3. installs pjsip.conf, extensions.conf, rtp.conf from /usr/share/slic/asterisk
#      into /etc/asterisk (an existing different file is kept as *.bak-DATE)
#   4. generates /etc/asterisk/pjsip_secrets.conf (random password per
#      account, readable by the asterisk user only) unless it exists
#   5. enables and (re)starts asterisk, prints the SIP accounts

TPL=/usr/share/slic/asterisk
ETC=/etc/asterisk
SECRETS=$ETC/pjsip_secrets.conf
ACCOUNTS="201 202 203"
MODULES="asterisk asterisk-pjsip asterisk-res-rtp-asterisk asterisk-bridge-simple
 asterisk-bridge-native-rtp asterisk-bridge-builtin-features asterisk-codec-ulaw
 asterisk-codec-alaw asterisk-codec-g722 asterisk-codec-gsm asterisk-res-audiosocket
 asterisk-app-audiosocket asterisk-chan-audiosocket asterisk-pbx-spool
 asterisk-app-system asterisk-func-env asterisk-func-shell asterisk-app-waitforcond
 asterisk-app-verbose asterisk-func-cut asterisk-func-channel asterisk-sounds
 asterisk-format-gsm asterisk-format-wav asterisk-format-sln asterisk-res-musiconhold
 asterisk-app-senddtmf asterisk-app-originate"

do_apk=1 newpw=0
for a in "$@"; do
	case $a in
	--no-apk) do_apk=0 ;;
	--new-passwords) newpw=1 ;;
	*) echo "usage: [APP=host:port] $0 [--no-apk] [--new-passwords]" >&2; exit 2 ;;
	esac
done

die() { echo "slic-asterisk-setup: $*" >&2; exit 1; }

# 1. modules
if [ $do_apk = 1 ]; then
	echo "installing Asterisk modules..."
	# shellcheck disable=SC2086
	apk add $MODULES >/dev/null || die "apk add failed (run 'apk update' first?)"
fi
[ -x /usr/sbin/asterisk ] || die "asterisk is not installed"

# 2. LAN address: first network of the firewall zone named "lan"
zone=$(uci show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='lan'$/\1/p" | head -n 1)
[ -n "$zone" ] || die "no firewall zone named 'lan'"
for net in $(uci -q get "firewall.$zone.network"); do
	st=$(ifstatus "$net" 2>/dev/null) || continue
	ip=$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].address')
	len=$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].mask')
	[ -n "$ip" ] && break
done
[ -n "$ip" ] && [ -n "$len" ] || die "could not find the LAN IPv4 address"
eval "$(ipcalc.sh "$ip/$len")"	# sets NETWORK, NETMASK
echo "LAN: $ip (network $NETWORK/$NETMASK)"

# 3. configs
stamp=$(date +%Y%m%d-%H%M%S)
for f in pjsip.conf extensions.conf rtp.conf; do
	sed -e "s|@LAN_IP@|$ip|g" -e "s|@LAN_NET@|$NETWORK|g" -e "s|@LAN_MASK@|$NETMASK|g" \
	    -e "s|@APP@|${APP:-127.0.0.1:9092}|g" "$TPL/$f" > "$ETC/$f.new" || die "cannot write $ETC/$f"
	if [ -f "$ETC/$f" ] && ! cmp -s "$ETC/$f" "$ETC/$f.new"; then
		cp "$ETC/$f" "$ETC/$f.bak-$stamp"
		echo "kept the previous $f as $f.bak-$stamp"
	fi
	mv "$ETC/$f.new" "$ETC/$f"
done

# 4. passwords
if [ ! -s "$SECRETS" ] || [ $newpw = 1 ]; then
	(
		umask 077
		echo "; generated by slic-asterisk-setup on $(date -I); keep private"
		for ext in $ACCOUNTS; do
			pw=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 20)
			[ ${#pw} -eq 20 ] || exit 1
			printf '\n[%s-auth]\ntype=auth\nauth_type=userpass\nusername=%s\npassword=%s\n' \
				"$ext" "$ext" "$pw"
		done
	) > "$SECRETS.new" && mv "$SECRETS.new" "$SECRETS" || die "password generation failed"
	echo "new SIP passwords generated"
fi
chown asterisk:asterisk "$SECRETS"
chmod 0600 "$SECRETS"

# 5. service
uci -q set asterisk.general.enabled=1 && uci commit asterisk
/etc/init.d/asterisk enable
/etc/init.d/asterisk restart
# the phone's daemon must (re)create its FIFO with the asterisk group
[ -x /etc/init.d/slic ] && /etc/init.d/slic restart

echo
echo "SIP server: $ip port 5060 (UDP or TCP), LAN only. Accounts:"
awk -F= '/^username=/{u=$2} /^password=/{printf "  user %s  password %s\n", u, $2}' "$SECRETS"
echo "Dial 100 for the RJ11 phone, 600 echo test, 601 hello-world, 800 AudioSocket app."
