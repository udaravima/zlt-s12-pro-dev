#!/bin/sh
# slic-asterisk-setup - turn the router into a LAN-only home PBX with the
# RJ11 phone as extension 100. Safe to re-run.
#
#   slic-asterisk-setup              install modules, configs, secrets; start
#   slic-asterisk-setup --no-apk     skip `apk add` (modules already there)
#   slic-asterisk-setup --with-ari   also install ARI (REST + events) for apps
#                                    like the call agent; automatic when
#                                    ari.conf already has enabled = yes
#                                    (e.g. restored from a backup); --no-ari
#                                    skips it
#   slic-asterisk-setup --new-passwords   new passwords for every account
#   ACCOUNTS="204 205" slic-asterisk-setup --no-apk   add SIP accounts (2XX)
#   APP=192.168.1.20:9092 slic-asterisk-setup   AudioSocket app for ext 800
#                                  (remembered: re-runs keep the last APP)
#   TONES=uk slic-asterisk-setup   ringback/busy tones of another country
#                                  (indications.conf; default lk, Sri Lanka)
#
# What it does, in order:
#   1. apk add the Asterisk modules this setup uses, including the ARI
#      WebSocket client provider (official telephony feed), plus the ARI
#      group when wanted; notes hand-added Asterisk packages it doesn't use; then makes
#      /etc/asterisk enterable for the asterisk user and creates the log and
#      call-history folders (both lost or wrong after a factory reset)
#   2. finds the LAN address from the firewall's "lan" zone
#   3. installs pjsip.conf, extensions.conf, rtp.conf from /usr/share/slic/asterisk
#      into /etc/asterisk (an existing different file is kept as *.bak-DATE)
#      and selects the call-progress tones (adds Sri Lanka's to indications.conf)
#   4. SIP accounts, through slic-accounts sync: every account already in
#      pjsip_secrets.conf plus $ACCOUNTS (201 202 203 on a first run). New
#      accounts get a random password; existing ones keep theirs. Writes
#      pjsip_secrets.conf (readable by the asterisk user only) and
#      pjsip_accounts.conf. One account at a time, without restarting
#      Asterisk: slic-accounts add|reset|remove EXT (or LuCI → Phone → Accounts).
#
# Never touched, for your own additions: pjsip_local.conf, extensions_local.conf
#   5. enables and (re)starts asterisk, prints the SIP accounts

TPL=/usr/share/slic/asterisk
ETC=/etc/asterisk
SECRETS=$ETC/pjsip_secrets.conf
MODULES="asterisk asterisk-pjsip asterisk-res-rtp-asterisk asterisk-bridge-simple
 asterisk-bridge-native-rtp asterisk-bridge-builtin-features asterisk-codec-ulaw
 asterisk-codec-alaw asterisk-codec-g722 asterisk-codec-gsm asterisk-res-audiosocket
 asterisk-app-audiosocket asterisk-chan-audiosocket asterisk-pbx-spool
 asterisk-app-system asterisk-func-env asterisk-func-shell asterisk-app-waitforcond
 asterisk-app-verbose asterisk-func-cut asterisk-func-channel asterisk-sounds
 asterisk-format-gsm asterisk-format-wav asterisk-format-sln asterisk-res-musiconhold
 asterisk-app-senddtmf asterisk-app-originate asterisk-res-websocket-client asterisk-chan-rtp
 asterisk-app-stasis asterisk-cdr-csv"
# ARI: the REST interface plus every resource. Each res-ari-* is a separate
# package and res-ari pulls in none of them; a missing one makes its URLs 404.
# (The call agent uses asterisk, bridges, channels, endpoints, events.)
ARI_MODULES="asterisk-res-ari asterisk-res-ari-model asterisk-res-ari-applications
 asterisk-res-ari-asterisk asterisk-res-ari-bridges asterisk-res-ari-channels
 asterisk-res-ari-device-states asterisk-res-ari-endpoints asterisk-res-ari-events
 asterisk-res-ari-mailboxes asterisk-res-ari-playbacks asterisk-res-ari-recordings
 asterisk-res-ari-sounds"

do_apk=1 newpw=0 ari=auto
for a in "$@"; do
	case $a in
	--no-apk) do_apk=0 ;;
	--new-passwords) newpw=1 ;;
	--with-ari) ari=1 ;;
	--no-ari) ari=0 ;;
	*) echo "usage: [APP=host:port] [ACCOUNTS='2XX ...'] [TONES=cc] $0 [--no-apk] [--new-passwords] [--with-ari|--no-ari]" >&2; exit 2 ;;
	esac
done

die() { echo "slic-asterisk-setup: $*" >&2; exit 1; }

# ARI on "auto": wanted when ari.conf's [general] says enabled = yes
if [ $ari = auto ]; then
	ari=0
	case $(sed -n '/^\[general\]/,/^\[/s/^[[:space:]]*enabled[[:space:]]*=[[:space:]]*\([A-Za-z0-9]*\).*/\1/p' \
		"$ETC/ari.conf" 2>/dev/null | head -n 1) in
	yes | true | 1) ari=1 ;;
	esac
fi
[ $ari = 1 ] && MODULES="$MODULES $ARI_MODULES"

# 1. modules
if [ $do_apk = 1 ]; then
	echo "installing Asterisk modules$([ $ari = 1 ] && echo ' (with ARI)')..."
	# shellcheck disable=SC2086
	apk add $MODULES >/dev/null || die "apk add failed (run 'apk update' first?)"
fi
[ -x /usr/sbin/asterisk ] || die "asterisk is not installed"
# report Asterisk packages someone added by hand that this setup doesn't use
# (only explicit ones: dependencies never appear in /etc/apk/world)
extra=$(sed 's/[<>=~].*//' /etc/apk/world 2>/dev/null | grep '^asterisk' | while read -r p; do
	case " $(echo $MODULES $ARI_MODULES) " in *" $p "*) ;; *) printf ' %s' "$p" ;; esac
done)
[ -n "$extra" ] && echo "note: also installed, not used by this setup:$extra"

# 1b. Asterisk reads asterisk.conf as root, then switches to user asterisk and
# reads everything else. A backup restored before the package was installed
# creates /etc/asterisk itself, mode 0700: Asterisk then exits at start with
# "'modules.conf' invalid or missing ... Module initialization failed".
# 755 is the package's own mode; pjsip_secrets.conf stays 0600 (step 4).
chmod 755 "$ETC"
# cdr_csv writes <astlogdir>/cdr-csv/Master.csv but never creates the folder,
# and the init script only creates the default /var/log/asterisk ones
logdir=$(sed -n 's/^astlogdir *=> *\([^ ;]*\).*/\1/p' "$ETC/asterisk.conf" 2>/dev/null)
logdir=${logdir:-/var/log/asterisk}
for d in "$logdir" "$logdir/cdr-csv"; do
	mkdir -p "$d" && chown asterisk:asterisk "$d" && chmod 750 "$d" || die "cannot create $d"
done

# 2. LAN address: first network of the firewall zone named "lan"
zone=$(uci show firewall | sed -n "s/^firewall\.\(@zone\[[0-9]*\]\)\.name='lan'$/\1/p" | head -n 1)
[ -n "$zone" ] || die "no firewall zone named 'lan'"
for net in $(uci -q get "firewall.$zone.network"); do
	st=$(ifstatus "$net" 2>/dev/null) || continue
	ip=$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].address')
	len=$(echo "$st" | jsonfilter -e '@["ipv4-address"][0].mask')
	[ -n "$ip" ] && break
done
[ -n "$ip" ] && [ -n "$len" ] || die "could not find the LAN IPv4 address"
eval "$(ipcalc.sh "$ip/$len")"	# sets NETWORK, NETMASK
echo "LAN: $ip (network $NETWORK/$NETMASK)"

# 3. configs
stamp=$(date +%Y%m%d-%H%M%S)
# ext 800's app: APP=..., else whatever the installed dialplan points at
[ -n "$APP" ] || APP=$(sed -n 's/^AUDIOSOCKET_APP=\([^ ;]*\).*/\1/p' "$ETC/extensions.conf" 2>/dev/null)
case $APP in *@*|"") APP=127.0.0.1:9092 ;; esac
for f in pjsip.conf extensions.conf rtp.conf; do
	sed -e "s|@LAN_IP@|$ip|g" -e "s|@LAN_NET@|$NETWORK|g" -e "s|@LAN_MASK@|$NETMASK|g" \
	    -e "s|@APP@|$APP|g" "$TPL/$f" > "$ETC/$f.new" || die "cannot write $ETC/$f"
	if [ -f "$ETC/$f" ] && ! cmp -s "$ETC/$f" "$ETC/$f.new"; then
		cp "$ETC/$f" "$ETC/$f.bak-$stamp"
		echo "kept the previous $f as $f.bak-$stamp"
	fi
	mv "$ETC/$f.new" "$ETC/$f"
done

# 3b. call-progress tones (what callers hear: ringback, busy): TONES=xx picks
# an indications.conf country; the default lk (Sri Lanka) isn't in Asterisk's
# stock file, so its section is appended once
TONES=${TONES:-lk}
IND=$ETC/indications.conf
if [ "$TONES" = lk ] && ! grep -q '^\[lk\]' "$IND"; then
	cp "$IND" "$IND.bak-$stamp"
	cat "$TPL/indications-lk.conf" >> "$IND"
fi
grep -q "^\[$TONES\]" "$IND" || die "no [$TONES] tones in $IND"
sed -i "s/^country=.*/country=$TONES/" "$IND"

# 4. accounts and passwords: slic-accounts, the same code the LuCI Accounts
# page uses (keeps existing passwords, adds $ACCOUNTS, 201-203 on a first
# run). --no-reload: step 5 restarts Asterisk anyway.
acc=$(dirname "$0")/slic-accounts
[ -x "$acc" ] || acc=slic-accounts
# shellcheck disable=SC2046,SC2086
"$acc" --no-reload sync $([ $newpw = 1 ] && echo --new-passwords) $ACCOUNTS ||
	die "accounts: slic-accounts failed"

# 5. service
uci -q set asterisk.general.enabled=1 && uci commit asterisk
/etc/init.d/asterisk enable
/etc/init.d/asterisk restart
# the phone's daemon must (re)create its FIFO with the asterisk group
[ -x /etc/init.d/slic ] && /etc/init.d/slic restart

echo
echo "SIP server: $ip port 5060 (UDP or TCP), LAN only. Accounts:"
awk -F= '/^username=/{u=$2} /^password=/{printf "  user %s  password %s\n", u, $2}' "$SECRETS"
echo "Dial 100 for the RJ11 phone, 600 echo test, 601 hello-world, 800 AudioSocket app ($APP)."
