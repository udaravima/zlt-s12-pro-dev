#!/bin/sh
# slic-accounts - the PBX's SIP accounts (extensions 200-299). The one place
# that writes them: slic-asterisk-setup (step 4) and the LuCI Accounts page
# (luci-app-slic-fxs, doc 16) both call this.
#
#   slic-accounts list              the extensions, one per line (no passwords)
#   slic-accounts show EXT          EXT's password
#   slic-accounts add EXT           a new account with a random password; prints it
#   slic-accounts reset EXT         a new random password for EXT; prints it
#   slic-accounts remove EXT        delete EXT's account
#   slic-accounts sync [--new-passwords] [EXT...]
#                                   keep every account, add the EXTs (none
#                                   yet and none given: 201 202 203); new
#                                   accounts get a password, existing ones keep
#                                   theirs unless --new-passwords
#   --no-reload (with any command)  don't tell Asterisk (the setup restarts it)
#
# Files, in /etc/asterisk (pjsip.conf pulls both in with #tryinclude):
#   pjsip_secrets.conf   [EXT-auth] username + password; mode 0600, user asterisk
#   pjsip_accounts.conf  [EXT](lan-endpoint) + [EXT](lan-aor); no secrets
# A change rewrites both, then "module reload res_pjsip.so": a new account can
# log in at once, calls in progress carry on. Passwords are 20 random letters
# and digits, printed only by show, add and reset (and slic-asterisk-setup).
#
# Testing on copies: SLIC_AST_ETC=<dir> SLIC_ACCOUNTS_LOCK=<file> NO_RELOAD=1
# NO_CHOWN=1 (no "asterisk" user needed).

ETC=${SLIC_AST_ETC:-/etc/asterisk}
SECRETS=$ETC/pjsip_secrets.conf
ACCTS=$ETC/pjsip_accounts.conf
LOCK=${SLIC_ACCOUNTS_LOCK:-/var/lock/slic-accounts.lock}

die() { echo "slic-accounts: $*" >&2; exit 1; }
usage() { die "usage: list | show EXT | add EXT | reset EXT | remove EXT | sync [--new-passwords] [EXT...]  [--no-reload]"; }
valid() { case $1 in 2[0-9][0-9]) return 0 ;; esac; return 1; }
need_ext() { valid "$1" || die "'$1': an extension from 200 to 299 (the dialplan's 2XX)"; }

# "EXT PASSWORD" per account
current() { awk -F= '/^username=/{u=$2} /^password=/{print u, $2}' "$SECRETS" 2>/dev/null; }

newpw() {
	# tr's stderr: when head stops reading, tr gets EPIPE, and where SIGPIPE is
	# ignored (under rpcd, i.e. from LuCI) it says "write error: Broken pipe"
	p=$(tr -dc 'A-Za-z0-9' < /dev/urandom 2>/dev/null | head -c 20)
	[ ${#p} -eq 20 ] || die "password generation failed"
	echo "$p"
}

# both files from "EXT PASSWORD" lines in $1; the secrets file is complete,
# private and owned by asterisk before it replaces the old one
write_files() {
	local ext pw	# the loops' own: the caller's new password is in $newp
	(
		umask 077
		echo "; generated by slic-accounts (slic-asterisk-setup, LuCI); keep private."
		echo "; Change accounts with slic-accounts, not by editing this file."
		while read -r ext pw; do
			[ ${#pw} -ge 12 ] || exit 1
			printf '\n[%s-auth]\ntype=auth\nauth_type=userpass\nusername=%s\npassword=%s\n' \
				"$ext" "$ext" "$pw"
		done < "$1"
	) > "$SECRETS.new" || { rm -f "$SECRETS.new"; die "cannot write $SECRETS"; }
	[ -n "$NO_CHOWN" ] || chown asterisk:asterisk "$SECRETS.new" || die "chown failed"
	chmod 0600 "$SECRETS.new" && mv "$SECRETS.new" "$SECRETS" || die "cannot replace $SECRETS"
	while read -r ext pw; do
		printf '\n[%s](lan-endpoint)\nauth=%s-auth\naors=%s\ncallerid="Ext %s" <%s>\n[%s](lan-aor)\n' \
			"$ext" "$ext" "$ext" "$ext" "$ext" "$ext"
	done < "$1" > "$ACCTS.new" || die "cannot write $ACCTS"
	# explicit mode: Asterisk runs as user asterisk, and #tryinclude silently
	# skips a file it can't read, which unloads every account. rpcd (LuCI)
	# runs us with umask 077, which made this file 0600 root on 2026-11-17.
	chmod 0644 "$ACCTS.new" && mv "$ACCTS.new" "$ACCTS" || die "cannot replace $ACCTS"
}

tell_asterisk() {
	[ -z "$NO_RELOAD" ] || return 0
	if ! asterisk -rx 'core show version' >/dev/null 2>&1; then
		echo "slic-accounts: Asterisk isn't running; the change applies when it starts" >&2
		return 0
	fi
	asterisk -rx 'module reload res_pjsip.so' >/dev/null || die "Asterisk did not reload res_pjsip"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
# drop --no-reload wherever it is; rotating "$@" keeps every other argument
# intact (no re-splitting on spaces, no * expansion)
n=$#
while [ $n -gt 0 ]; do
	a=$1
	shift
	n=$((n - 1))
	case $a in
	--no-reload) NO_RELOAD=1 ;;
	*) set -- "$@" "$a" ;;
	esac
done

case $cmd in
list)
	current | cut -d' ' -f1
	exit 0 ;;
show)
	need_ext "$1"
	pw=$(current | awk -v u="$1" '$1 == u {print $2}')
	[ -n "$pw" ] || die "no account $1"
	echo "$pw"
	exit 0 ;;
add|reset|remove|sync) ;;
*) usage ;;
esac

T=$(mktemp) || die "mktemp failed"
trap 'rm -f "$T" "$T.x"' EXIT
exec 9>"$LOCK" && flock 9 || die "cannot lock $LOCK"
current > "$T"

case $cmd in
add)
	need_ext "$1"
	grep -q "^$1 " "$T" && die "account $1 already exists"
	newp=$(newpw) || exit 1
	echo "$1 $newp" >> "$T" ;;
reset)
	need_ext "$1"
	grep -q "^$1 " "$T" || die "no account $1"
	newp=$(newpw) || exit 1
	awk -v u="$1" -v p="$newp" '$1 == u {$2 = p} {print}' "$T" > "$T.x" && mv "$T.x" "$T" ;;
remove)
	need_ext "$1"
	grep -q "^$1 " "$T" || die "no account $1"
	grep -v "^$1 " "$T" > "$T.x"
	mv "$T.x" "$T" ;;
sync)
	all=0 exts=
	for a in "$@"; do
		case $a in
		--new-passwords) all=1 ;;
		*) need_ext "$a"; exts="$exts $a" ;;
		esac
	done
	[ -s "$T" ] || [ -n "$exts" ] || exts="201 202 203"
	for x in $exts; do
		grep -q "^$x " "$T" || echo "$x -" >> "$T"	# "-": needs a password
	done
	while read -r ext p; do
		if [ "$p" = - ] || [ $all = 1 ]; then
			p=$(newpw) || exit 1
			echo "new password for $ext" >&2
		fi
		echo "$ext $p"
	done < "$T" > "$T.x" && mv "$T.x" "$T" ;;
esac

# by extension, one line each. Plain sort only: OpenWrt's BusyBox sort has no
# -k or -o, and given them it prints the file instead (here: passwords)
sort "$T" | awk '!seen[$1]++' > "$T.x" && mv "$T.x" "$T" || die "sort failed"
write_files "$T"
tell_asterisk
case $cmd in add|reset) echo "$newp" ;; esac
exit 0
